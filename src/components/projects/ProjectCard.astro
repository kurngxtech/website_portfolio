---
import type { Project } from '../../data/projects';
import { t } from '../../i18n/translations';

export interface Props {
  project: Project;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const thumbnailSrc = project.thumbnail || '/images/project-saint-ink.svg';
const caseStudyUrl = `/projects/${project.slug}`;
---

<div
  class:list={[
    'group relative flex flex-col w-full rounded-2xl border transition-all duration-300 overflow-hidden bg-white/85 dark:bg-zinc-900/75 backdrop-blur-md shadow-md shadow-zinc-900/5 dark:shadow-black/30 hover:-translate-y-1 hover:shadow-xl hover:shadow-zinc-900/10 dark:hover:shadow-blue-500/5',
    featured
      ? 'border-zinc-300/90 dark:border-zinc-700/80 hover:border-blue-500/50 dark:hover:border-blue-500/50'
      : 'border-zinc-200/70 dark:border-zinc-800/70 hover:border-blue-500/40 dark:hover:border-blue-500/40',
  ]}
>
  <!-- Main Card Anchor linking directly to the Deep Case Study -->
  <a
    href={caseStudyUrl}
    class="absolute inset-0 z-10 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-inset rounded-2xl"
    aria-label={`Read case study for ${project.title}`}
  >
    <span class="sr-only">Read case study for {project.title}</span>
  </a>

  <!-- Editorial Card Header (Category, Status & Year) -->
  <div class="flex items-center justify-between px-4 py-2.5 bg-zinc-100/70 dark:bg-zinc-800/50 border-b border-zinc-200/60 dark:border-zinc-800/60 text-xs">
    <div class="flex items-center gap-2">
      <span
        class:list={[
          'w-1.5 h-1.5 rounded-full shrink-0',
          project.status === 'Deployed to Production' ? 'bg-emerald-500' : 'bg-blue-500',
        ]}
        aria-hidden="true"
      ></span>
      <span
        class="text-[11px] font-sans font-semibold text-zinc-700 dark:text-zinc-300 truncate max-w-[200px]"
        data-i18n-en={project.category}
        data-i18n-id={project.categoryId || project.category}
      >
        {project.category}
      </span>
    </div>

    <div class="flex items-center gap-2 text-[11px] font-mono text-zinc-400">
      <span>{project.year}</span>
    </div>
  </div>

  <!-- Showcase Canvas -->
  <div class="relative w-full h-48 sm:h-52 overflow-hidden bg-zinc-950/90 border-b border-zinc-200/50 dark:border-zinc-800/50">
    <img
      src={thumbnailSrc}
      alt={`${project.title} Preview`}
      loading="lazy"
      decoding="async"
      width="580"
      height="208"
      class="w-full h-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-[1.02]"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/60 via-transparent to-transparent pointer-events-none" aria-hidden="true"></div>

    <!-- External Secondary Links (Higher z-index so clicking opens demo/repo) -->
    <div class="absolute top-2.5 right-2.5 z-20 flex items-center gap-1.5">
      {project.liveUrl && (
        <a
          href={project.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-sans font-medium bg-zinc-900/80 text-zinc-200 backdrop-blur-md border border-white/15 hover:bg-blue-600 hover:text-white transition-colors shadow-sm"
          title="Open live deployment"
        >
          <span>Live</span>
          <span aria-hidden="true">↗</span>
        </a>
      )}
      {project.repositoryUrl && (
        <a
          href={project.repositoryUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-sans font-medium bg-zinc-900/80 text-zinc-200 backdrop-blur-md border border-white/15 hover:bg-zinc-800 hover:text-white transition-colors shadow-sm"
          title="Open source code repository"
        >
          <span>Repo</span>
          <span aria-hidden="true">↗</span>
        </a>
      )}
    </div>

    <!-- Case Study Indicator Pill -->
    <div class="absolute bottom-2.5 left-3 z-10">
      <span class="inline-flex items-center gap-1 text-[11px] font-sans font-medium text-zinc-200 bg-zinc-900/70 px-2.5 py-1 rounded-md backdrop-blur-md border border-white/10 group-hover:border-blue-400/40 group-hover:text-blue-200 transition-colors">
        <span>Case Study</span>
        <span class="transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true">→</span>
      </span>
    </div>
  </div>

  <!-- Editorial Project Details -->
  <div class="p-4 sm:p-5 flex flex-col justify-between flex-1 space-y-3.5">
    <div>
      <div class="flex items-start justify-between gap-2">
        <h3 class="text-base sm:text-lg font-bold tracking-tight text-zinc-900 dark:text-zinc-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
          <span
            data-i18n-en={project.title}
            data-i18n-id={project.titleId || project.title}
          >
            {project.title}
          </span>
        </h3>
      </div>

      <!-- Description (3 lines max clamp) -->
      <p
        class="mt-1.5 text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed font-normal line-clamp-3"
        data-i18n-en={project.description}
        data-i18n-id={project.descriptionId || project.description}
      >
        {project.description}
      </p>

      <!-- Role Metadata -->
      <div class="mt-3 pt-2.5 border-t border-zinc-100 dark:border-zinc-800/60 flex items-center justify-between text-[11px] text-zinc-500 dark:text-zinc-400 font-sans">
        <div class="flex items-center gap-1.5 truncate">
          <span data-i18n-key="projects.card.role">{t('projects.card.role')}</span>
          <span
            class="font-medium text-zinc-800 dark:text-zinc-200 truncate"
            data-i18n-en={project.role}
            data-i18n-id={project.roleId || project.role}
          >
            {project.role}
          </span>
        </div>
        <span class="text-zinc-400 shrink-0 font-mono text-[10px]">
          {project.status === 'Deployed to Production' ? '● Prod Verified' : '● Completed'}
        </span>
      </div>
    </div>

    <!-- Tech tags -->
    <div class="pt-1 flex flex-wrap gap-1">
      {project.technologies.slice(0, 4).map((tech) => (
        <span class="px-2 py-0.5 rounded-md text-[11px] font-sans font-medium bg-zinc-100 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300 border border-zinc-200/50 dark:border-zinc-700/50">
          {tech}
        </span>
      ))}
      {project.technologies.length > 4 && (
        <span class="px-1.5 py-0.5 rounded-md text-[10px] font-sans font-medium bg-zinc-100/60 dark:bg-zinc-800/40 text-zinc-400">
          +{project.technologies.length - 4}
        </span>
      )}
    </div>
  </div>
</div>
