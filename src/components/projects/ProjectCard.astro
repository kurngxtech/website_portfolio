---
import type { Project } from '../../data/projects';
import Badge from '../ui/Badge.astro';

export interface Props {
  project: Project;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
---

<article
  class:list={[
    'group relative flex flex-col justify-between rounded-xl border transition-all duration-200 bg-white dark:bg-zinc-900/60 p-6 md:p-8',
    featured
      ? 'border-zinc-300 dark:border-zinc-700/80 shadow-xs hover:border-blue-500/60 dark:hover:border-blue-500/60'
      : 'border-zinc-200 dark:border-zinc-800 hover:border-zinc-300 dark:hover:border-zinc-700',
  ]}
>
  <div>
    <!-- Category & Status / Year -->
    <div class="flex items-center justify-between gap-2 text-xs font-mono mb-3">
      <span class="text-blue-600 dark:text-blue-400 font-medium">
        {project.category}
      </span>
      <span class="text-zinc-400 dark:text-zinc-500">
        {project.year}
      </span>
    </div>

    <!-- Title -->
    <h3 class="text-xl md:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
      <a href={`/projects/${project.slug}`} class="focus:outline-none">
        <span class="absolute inset-0 z-10" aria-hidden="true"></span>
        {project.title}
      </a>
    </h3>

    <!-- Description -->
    <p class="mt-3 text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
      {project.description}
    </p>

    <!-- Role Metadata -->
    <div class="mt-4 pt-3 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center gap-2 text-xs text-zinc-500 dark:text-zinc-400 font-mono">
      <span>Role:</span>
      <span class="font-medium text-zinc-700 dark:text-zinc-300">{project.role}</span>
    </div>
  </div>

  <!-- Tech tags & Case Study Link -->
  <div class="mt-6 pt-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="flex flex-wrap gap-1.5">
      {project.technologies.slice(0, 4).map((tech) => (
        <Badge variant="default" size="sm">
          {tech}
        </Badge>
      ))}
      {project.technologies.length > 4 && (
        <Badge variant="outline" size="sm">
          +{project.technologies.length - 4}
        </Badge>
      )}
    </div>

    <span class="inline-flex items-center text-xs font-mono font-medium text-blue-600 dark:text-blue-400 group-hover:translate-x-0.5 transition-transform">
      View Case Study <span class="ml-1" aria-hidden="true">→</span>
    </span>
  </div>
</article>

