---
import { t } from '../../i18n/translations';
import type { TranslationKey } from '../../i18n/translations';

// Feature cards (icons are inline Lucide paths to avoid adding a dependency)
const features: { titleKey: TranslationKey; descKey: TranslationKey; icon: 'globe' | 'code' }[] = [
  { titleKey: 'study.feat1_title', descKey: 'study.feat1_desc', icon: 'globe' },
  { titleKey: 'study.feat2_title', descKey: 'study.feat2_desc', icon: 'code' },
];

// Campus cards
const campuses: {
  nameKey: TranslationKey;
  locationKey: TranslationKey;
  tagKey: TranslationKey;
  src: string;
  alt: string;
  width: number;
  height: number;
}[] = [
  {
    nameKey: 'study.stikom_name',
    locationKey: 'study.stikom_location',
    tagKey: 'study.stikom_tag',
    src: '/images/STIKOM_BALI_CAMPUS.webp',
    alt: 'ITB STIKOM Bali campus',
    width: 680,
    height: 510,
  },
  {
    nameKey: 'study.help_name',
    locationKey: 'study.help_location',
    tagKey: 'study.help_tag',
    src: '/images/HELP_uni.webp',
    alt: 'HELP University Malaysia campus',
    width: 1768,
    height: 1230,
  },
];
---

<section
  id="study"
  aria-labelledby="study-heading"
  class="py-16 sm:py-20 md:py-24 border-b border-zinc-200/70 dark:border-zinc-800/70"
>
  <div class="reveal-on-scroll mb-8 sm:mb-10">
    <span
      data-i18n-key="study.eyebrow"
      class="block text-xs font-sans uppercase tracking-wider text-blue-600 dark:text-blue-400 font-semibold mb-2"
    >
      {t('study.eyebrow')}
    </span>
    <h2
      id="study-heading"
      data-i18n-key="study.title"
      class="text-3xl sm:text-4xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50"
    >
      {t('study.title')}
    </h2>
  </div>

  <!-- Always-dark showcase container -->
  <div
    class="reveal-on-scroll relative overflow-hidden rounded-3xl border border-white/10 bg-[#0b0b0d] p-5 sm:p-8 lg:p-10 shadow-xl shadow-black/20"
  >
    <!-- Decorative cropped text -->
    <span
      aria-hidden="true"
      class="pointer-events-none select-none absolute -top-4 -right-6 sm:-top-6 sm:-right-10 text-[5.5rem] sm:text-[8rem] lg:text-[10rem] leading-none font-extrabold tracking-tighter text-white/[0.035] whitespace-nowrap"
      data-i18n-key="study.deco"
    >
      {t('study.deco')}
    </span>

    <div class="relative grid grid-cols-1 md:grid-cols-[1.1fr_1fr] lg:grid-cols-[58fr_42fr] gap-8 md:gap-8 lg:gap-12">
      <!-- LEFT: academic information -->
      <div class="flex flex-col">
        <ul class="flex flex-wrap gap-2" aria-label="Status">
          <li class="inline-flex items-center gap-1.5 rounded-full border border-blue-400/30 bg-blue-500/10 px-3 py-1 text-xs font-semibold text-blue-300">
            <span class="h-1.5 w-1.5 rounded-full bg-blue-400" aria-hidden="true"></span>
            <span data-i18n-key="study.badge">{t('study.badge')}</span>
          </li>
          <li class="inline-flex items-center rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-semibold text-zinc-300">
            <span data-i18n-key="study.gpa">{t('study.gpa')}</span>
          </li>
        </ul>

        <h3 class="mt-5 text-2xl sm:text-3xl font-extrabold tracking-tight text-white leading-tight">
          <span data-i18n-key="study.degree">{t('study.degree')}</span>
          <span class="block mt-1 text-base sm:text-lg font-semibold text-zinc-500" data-i18n-key="study.since">
            {t('study.since')}
          </span>
        </h3>

        <p class="mt-3 text-sm sm:text-base font-semibold text-zinc-200" data-i18n-key="study.institutions">
          {t('study.institutions')}
        </p>

        <p class="mt-4 text-sm sm:text-base leading-relaxed text-zinc-400" data-i18n-key="study.desc_text">
          {t('study.desc_text')}
        </p>

        <hr class="my-6 border-0 border-t border-white/10" />

        <ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-1 xl:grid-cols-2 gap-4">
          {
            features.map((f) => (
              <li class="group flex items-start gap-3.5 rounded-2xl border border-white/10 bg-white/[0.03] p-4 transition-colors duration-300 hover:border-white/20 hover:bg-white/[0.06]">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-white/15 text-zinc-200 transition-colors duration-300 group-hover:border-blue-400/50 group-hover:text-blue-300">
                  {f.icon === 'globe' ? (
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="10" />
                      <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
                      <path d="M2 12h20" />
                    </svg>
                  ) : (
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m18 16 4-4-4-4" />
                      <path d="m6 8-4 4 4 4" />
                      <path d="m14.5 4-5 16" />
                    </svg>
                  )}
                </span>
                <div class="min-w-0">
                  <h4 class="text-sm font-bold text-white" data-i18n-key={f.titleKey}>{t(f.titleKey)}</h4>
                  <p class="mt-1 text-xs leading-relaxed text-zinc-400" data-i18n-key={f.descKey}>{t(f.descKey)}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- RIGHT: campus cards -->
      <div class="grid grid-cols-1 gap-4 lg:grid-rows-2">
        {
          campuses.map((c) => (
            <figure class="group relative overflow-hidden rounded-2xl border border-white/10 bg-zinc-900 aspect-[16/10] md:aspect-auto md:min-h-[200px]">
              <img
                src={c.src}
                alt={c.alt}
                width={c.width}
                height={c.height}
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent" aria-hidden="true" />
              <figcaption class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-3 p-4 sm:p-5">
                <div class="min-w-0">
                  <p class="text-sm sm:text-base font-bold text-white leading-snug" data-i18n-key={c.nameKey}>{t(c.nameKey)}</p>
                  <p class="mt-1 flex items-center gap-1.5 text-xs text-zinc-300">
                    <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
                      <circle cx="12" cy="10" r="3" />
                    </svg>
                    <span data-i18n-key={c.locationKey}>{t(c.locationKey)}</span>
                  </p>
                </div>
                <span
                  class="shrink-0 rounded-full border border-white/20 bg-black/40 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-zinc-200 backdrop-blur-sm"
                  data-i18n-key={c.tagKey}
                >
                  {t(c.tagKey)}
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>

