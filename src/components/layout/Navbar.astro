---
import ThemeToggle from '../ui/ThemeToggle.astro';
import LanguageToggle from '../ui/LanguageToggle.astro';
import { t, type TranslationKey } from '../../i18n/translations';

interface NavLink {
  href: string;
  key: TranslationKey;
  id: string;
}

const navLinks: NavLink[] = [
  { href: '#about', key: 'nav.about', id: 'about' },
  { href: '#projects', key: 'nav.work', id: 'projects' },
  { href: '#experience', key: 'nav.experience', id: 'experience' },
  { href: '#skills', key: 'nav.skills', id: 'skills' },
  { href: '#contact', key: 'nav.contact', id: 'contact' },
];
---

<!-- Floating Pill Navbar -->
<header class="fixed top-3 sm:top-4 left-1/2 -translate-x-1/2 z-50 w-[94%] max-w-4xl rounded-full border border-zinc-200/80 dark:border-zinc-800/80 bg-white/85 dark:bg-zinc-900/85 backdrop-blur-md shadow-lg shadow-zinc-900/5 dark:shadow-black/40 px-3 sm:px-4 py-2 transition-all">
  <div class="flex items-center justify-between gap-2">
    <!-- Brand / Name -->
    <a
      href="#hero"
      class="group flex items-center gap-2 font-sans text-xs sm:text-sm font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 hover:text-blue-600 dark:hover:text-blue-400 transition-colors pl-1"
    >
      <span class="w-2 h-2 rounded-full bg-blue-600 dark:bg-blue-500 group-hover:scale-125 transition-transform" aria-hidden="true"></span>
      <span data-i18n-key="nav.brand">{t('nav.brand')}</span>
    </a>

    <!-- Desktop Navigation Links with ScrollSpy Highlighting -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Single Page Navigation">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            data-nav-id={link.id}
            data-i18n-key={link.key}
            class="nav-anchor-link px-3 py-1 text-xs font-sans font-medium rounded-full transition-all duration-200 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100/80 dark:hover:bg-zinc-800/60"
          >
            {t(link.key)}
          </a>
        ))
      }
    </nav>

    <!-- Actions: CV, Language Toggle & Theme Toggle -->
    <div class="flex items-center gap-1.5 sm:gap-2">
      <a
        href="/Bagus_Kurniawan_CV.pdf"
        download="Bagus_Kurniawan_CV.pdf"
        class="hidden sm:inline-flex items-center px-2.5 py-1 text-xs font-sans font-medium border border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 rounded-full hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors"
      >
        <span data-i18n-key="nav.cv">{t('nav.cv')}</span>
      </a>

      <!-- Bilingual EN / ID Switcher -->
      <LanguageToggle />

      <!-- Theme Switcher -->
      <ThemeToggle />

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-button"
        type="button"
        aria-label={t('nav.menu_toggle')}
        aria-expanded="false"
        class="md:hidden p-1.5 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 rounded-full hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors cursor-pointer"
      >
        <svg
          id="menu-icon-open"
          class="w-5 h-5 block"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg
          id="menu-icon-close"
          class="w-5 h-5 hidden"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden mt-3 pt-3 pb-2 border-t border-zinc-200/80 dark:border-zinc-800/80 space-y-1"
  >
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          data-nav-id={link.id}
          data-i18n-key={link.key}
          class="mobile-nav-link block px-3 py-1.5 text-xs font-sans font-medium rounded-full transition-colors text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800"
        >
          {t(link.key)}
        </a>
      ))
    }
    <div class="pt-2 mt-1 border-t border-zinc-100 dark:border-zinc-800/60 flex items-center justify-between px-2">
      <a
        href="/Bagus_Kurniawan_CV.pdf"
        download="Bagus_Kurniawan_CV.pdf"
        class="text-xs font-sans font-medium text-blue-600 dark:text-blue-400 hover:underline"
      >
        <span data-i18n-key="nav.download_cv">{t('nav.download_cv')}</span>
      </a>
    </div>
  </div>
</header>

<script>
  import { animate } from 'motion';

  // Mobile Hamburger Toggle with Motion
  function setupMobileMenu() {
    const menuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIconOpen = document.getElementById('menu-icon-open');
    const menuIconClose = document.getElementById('menu-icon-close');

    if (!menuButton || !mobileMenu || !menuIconOpen || !menuIconClose) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const openMenu = () => {
      menuButton.setAttribute('aria-expanded', 'true');
      mobileMenu.classList.remove('hidden');
      menuIconOpen.classList.add('hidden');
      menuIconClose.classList.remove('hidden');

      if (!prefersReducedMotion) {
        animate(mobileMenu, { opacity: [0, 1], y: [-8, 0] }, { duration: 0.22, ease: [0.16, 1, 0.3, 1] });
      }
    };

    const closeMenu = () => {
      menuButton.setAttribute('aria-expanded', 'false');
      menuIconOpen.classList.remove('hidden');
      menuIconClose.classList.add('hidden');

      if (!prefersReducedMotion) {
        const anim = animate(mobileMenu, { opacity: [1, 0], y: [0, -6] }, { duration: 0.16, ease: [0.16, 1, 0.3, 1] });
        anim.then(() => {
          mobileMenu.classList.add('hidden');
        });
      } else {
        mobileMenu.classList.add('hidden');
      }
    };

    menuButton.addEventListener('click', () => {
      const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Close mobile menu upon clicking any anchor
    document.querySelectorAll('.mobile-nav-link').forEach((link) => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });
  }

  // ScrollSpy to highlight active section in floating navbar
  function setupScrollSpy() {
    const navLinks = document.querySelectorAll<HTMLElement>('.nav-anchor-link, .mobile-nav-link');
    const sectionIds = ['about', 'projects', 'experience', 'skills', 'contact'];
    const sections: HTMLElement[] = [];

    sectionIds.forEach((id) => {
      const el = document.getElementById(id);
      if (el) sections.push(el);
    });

    if (sections.length === 0) return;

    const highlightActiveNav = () => {
      const scrollPosition = window.scrollY + 180;
      let activeSectionId = '';

      for (let i = sections.length - 1; i >= 0; i--) {
        const section = sections[i];
        if (section.offsetTop <= scrollPosition) {
          activeSectionId = section.id;
          break;
        }
      }

      navLinks.forEach((link) => {
        const linkNavId = link.getAttribute('data-nav-id');
        if (linkNavId === activeSectionId) {
          link.classList.add('bg-blue-500/10', 'text-blue-600', 'dark:text-blue-400', 'font-semibold');
          link.classList.remove('text-zinc-600', 'dark:text-zinc-400');
        } else {
          link.classList.remove('bg-blue-500/10', 'text-blue-600', 'dark:text-blue-400', 'font-semibold');
          link.classList.add('text-zinc-600', 'dark:text-zinc-400');
        }
      });
    };

    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            highlightActiveNav();
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true }
    );
    highlightActiveNav();
  }

  const initNavbar = () => {
    setupMobileMenu();
    setupScrollSpy();
  };

  document.addEventListener('astro:page-load', initNavbar);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNavbar);
  } else {
    initNavbar();
  }
</script>
