---
const currentYear = 2026;
import { t } from '../../i18n/translations';
---

<footer class="mt-auto border-t border-zinc-200 dark:border-zinc-800/80 bg-white/50 dark:bg-zinc-950/50 py-12 transition-colors">
  <div class="w-full max-w-[92vw] sm:max-w-[88vw] md:max-w-[80vw] lg:max-w-[50vw] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <span class="font-sans text-sm font-semibold text-zinc-900 dark:text-zinc-100">
          Bagus Kurniawan
        </span>
        <p
          class="text-xs text-zinc-500 dark:text-zinc-400 mt-1 font-sans"
          data-i18n-key="footer.tagline"
        >
          {t('footer.tagline')}
        </p>
        <p
          class="text-xs text-zinc-400 dark:text-zinc-500 mt-1 font-sans"
          data-i18n-key="footer.built_with"
        >
          {t('footer.built_with')}
        </p>
      </div>

      <!-- Links -->
      <div class="flex flex-wrap items-center gap-6 text-xs font-sans font-medium text-zinc-600 dark:text-zinc-400">
        <a
          href="https://github.com/kurngxtech/"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
        >
          GitHub
        </a>
        <a
          href="mailto:gedebagusk@gmail.com"
          class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
        >
          Email
        </a>
        <a
          href="/Bagus_Kurniawan_CV.pdf"
          download="Bagus_Kurniawan_CV.pdf"
          class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
        >
          <span data-i18n-key="footer.resume">{t('footer.resume')}</span>
        </a>
      </div>
    </div>

    <div class="mt-8 pt-6 border-t border-zinc-100 dark:border-zinc-900 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-sans text-zinc-400 dark:text-zinc-500">
      <span data-i18n-key="footer.copyright">
        {t('footer.copyright')}
      </span>
      <span>kurngxtech.dev</span>
    </div>
  </div>
</footer>
