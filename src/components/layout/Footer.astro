---
const currentYear = 2026;
---

<footer class="mt-auto border-t border-zinc-200 dark:border-zinc-800/80 bg-white/50 dark:bg-zinc-950/50 py-12 transition-colors">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <span class="font-mono text-sm font-semibold text-zinc-900 dark:text-zinc-100">
          Bagus Kurniawan
        </span>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1 font-mono">
          Software Engineer · Building reliable systems
        </p>
        <p class="text-xs text-zinc-400 dark:text-zinc-500 mt-2 font-mono">
          Built with Astro · TypeScript · Tailwind CSS
        </p>
      </div>

      <!-- Links -->
      <div class="flex flex-wrap items-center gap-6 text-xs font-mono text-zinc-600 dark:text-zinc-400">
        <a
          href="https://github.com/kurngxtech/"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
        >
          GitHub
        </a>
        <a
          href="/contact"
          class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
        >
          LinkedIn [Placeholder]
        </a>
        <a
          href="mailto:bagus.kurniawan@example.com"
          class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
        >
          Email [Placeholder]
        </a>
        <a
          href="/resume"
          class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
        >
          Resume
        </a>
      </div>
    </div>

    <div class="mt-8 pt-6 border-t border-zinc-100 dark:border-zinc-900 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-zinc-400 dark:text-zinc-500">
      <span>© {currentYear} Bagus Kurniawan. All rights reserved.</span>
      <span>kurngxtech.dev</span>
    </div>
  </div>
</footer>

