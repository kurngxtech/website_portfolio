---
export interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  class?: string;
}

const { eyebrow, title, description, class: className = '' } = Astro.props;
---

<div class:list={['mb-8 md:mb-12', className]}>
  {
    eyebrow && (
      <span class="block font-mono text-xs text-blue-600 dark:text-blue-400 uppercase tracking-wider mb-2 font-medium">
        {eyebrow}
      </span>
    )
  }
  <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
    {title}
  </h2>
  {
    description && (
      <p class="mt-2 text-sm md:text-base text-zinc-600 dark:text-zinc-400 max-w-2xl">
        {description}
      </p>
    )
  }
</div>

