---
---

<!-- Ultra-Smooth GPU-Composited Background Ripple Layer (z-0: runs behind content) -->
<div
  id="theme-ripple-overlay"
  class="fixed inset-0 z-0 pointer-events-none overflow-hidden hidden select-none"
  aria-hidden="true"
  style="contain: strict;"
>
  <!-- Base canvas layer holding previous background color -->
  <div
    id="theme-ripple-base"
    class="absolute inset-0 pointer-events-none"
    style="will-change: background-color;"
  ></div>

  <!-- Concentric Water Wave Ring (ripple crest) -->
  <div
    id="theme-ripple-wave"
    class="absolute top-1/2 left-1/2 rounded-full pointer-events-none opacity-0"
    style="will-change: transform, opacity; transform: translate3d(-50%, -50%, 0) scale(0.005);"
  ></div>

  <!-- Main Soft Blurred Water Droplet (hardware-accelerated radial feathering) -->
  <div
    id="theme-ripple-circle"
    class="absolute top-1/2 left-1/2 rounded-full pointer-events-none"
    style="will-change: transform; transform: translate3d(-50%, -50%, 0) scale(0.005);"
  ></div>
</div>

<script>
  let isAnimating = false;

  export function triggerThemeTransition(triggerButton?: HTMLElement | null) {
    if (isAnimating) return;

    const overlay = document.getElementById('theme-ripple-overlay');
    const base = document.getElementById('theme-ripple-base');
    const circle = document.getElementById('theme-ripple-circle');
    const wave = document.getElementById('theme-ripple-wave');

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const isCurrentlyDark = document.documentElement.classList.contains('dark');
    const willBeDark = !isCurrentlyDark;

    // Instant switch for reduced-motion preference
    if (prefersReducedMotion || !overlay || !base || !circle || !wave) {
      if (willBeDark) {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      } else {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      }
      return;
    }

    isAnimating = true;

    // Lightweight tactile button feedback
    if (triggerButton && triggerButton.animate) {
      triggerButton.animate(
        [
          { transform: 'scale(0.86)' },
          { transform: 'scale(1)' }
        ],
        { duration: 280, easing: 'cubic-bezier(0.34, 1.56, 0.64, 1)' }
      );
    }

    // Geometry: diameter sized so the solid 70% core covers every corner
    const w = window.innerWidth;
    const h = window.innerHeight;
    const maxDim = Math.hypot(w, h);
    const diameter = Math.ceil(maxDim / 0.7) + 60;

    const oldBg = isCurrentlyDark ? '#09090b' : '#fafafa';
    const newBg = willBeDark ? '#09090b' : '#fafafa';

    base.style.backgroundColor = oldBg;

    if (willBeDark) {
      circle.style.background = `radial-gradient(circle at center, #09090b 0%, #09090b 68%, rgba(9, 9, 11, 0.85) 78%, rgba(9, 9, 11, 0.5) 88%, rgba(9, 9, 11, 0) 100%)`;
      wave.style.border = '2px solid rgba(59, 130, 246, 0.45)';
      wave.style.boxShadow = '0 0 24px rgba(59, 130, 246, 0.3)';
    } else {
      circle.style.background = `radial-gradient(circle at center, #fafafa 0%, #fafafa 68%, rgba(250, 250, 250, 0.85) 78%, rgba(250, 250, 250, 0.5) 88%, rgba(250, 250, 250, 0) 100%)`;
      wave.style.border = '2px solid rgba(37, 99, 235, 0.4)';
      wave.style.boxShadow = '0 0 24px rgba(37, 99, 235, 0.25)';
    }

    circle.style.width = `${diameter}px`;
    circle.style.height = `${diameter}px`;
    wave.style.width = `${diameter}px`;
    wave.style.height = `${diameter}px`;

    overlay.classList.remove('hidden');

    // Immediately toggle theme classes so text & cards adapt directly
    if (willBeDark) {
      document.documentElement.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    } else {
      document.documentElement.classList.remove('dark');
      localStorage.setItem('theme', 'light');
    }

    // Hardware-accelerated Web Animations API
    wave.animate(
      [
        { transform: 'translate3d(-50%, -50%, 0) scale(0.005)', opacity: 0.85 },
        { transform: 'translate3d(-50%, -50%, 0) scale(1.06)', opacity: 0 }
      ],
      { duration: 500, easing: 'cubic-bezier(0, 0, 0.2, 1)', fill: 'forwards' }
    );

    const circleAnim = circle.animate(
      [
        { transform: 'translate3d(-50%, -50%, 0) scale(0.005)' },
        { transform: 'translate3d(-50%, -50%, 0) scale(1)' }
      ],
      { duration: 460, easing: 'cubic-bezier(0, 0, 0.2, 1)', fill: 'forwards' }
    );

    circleAnim.onfinish = () => {
      base.style.backgroundColor = newBg;
      overlay.classList.add('hidden');
      isAnimating = false;
    };
  }

  // Global click interception on theme toggle button
  if (!(window as any).__theme_ripple_attached) {
    (window as any).__theme_ripple_attached = true;
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement)?.closest('#theme-toggle') as HTMLElement | null;
      if (!btn) return;
      triggerThemeTransition(btn);
    });
  }
</script>
