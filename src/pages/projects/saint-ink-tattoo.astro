---
import Layout from '../../layouts/Layout.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import ArchitectureDiagram from '../../components/projects/ArchitectureDiagram.astro';
import { projects } from '../../data/projects';

const project = projects.find((p) => p.slug === 'saint-ink-tattoo')!;
---

<Layout
  title={`${project.title} — Case Study | Bagus Kurniawan`}
  description={project.description}
>
  <div class="py-4 md:py-8 max-w-4xl mx-auto">
    <!-- Back Navigation -->
    <div class="mb-8">
      <a
        href="/projects"
        class="inline-flex items-center text-xs font-sans font-medium text-zinc-500 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
      >
        <span class="mr-1">←</span> Back to Projects
      </a>
    </div>

    <!-- Case Study Header -->
    <header class="border-b border-zinc-200 dark:border-zinc-800 pb-8 mb-10">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <Badge variant="accent">{project.category}</Badge>
        <Badge variant="success">{project.status}</Badge>
        <span class="text-xs font-sans font-medium text-zinc-400 dark:text-zinc-500">
          {project.year}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 mb-4">
        {project.title}
      </h1>

      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed max-w-3xl">
        {project.description}
      </p>

      <!-- Project Metadata Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-8 pt-6 border-t border-zinc-100 dark:border-zinc-800/80 text-xs font-sans">
        <div>
          <span class="block text-zinc-400 dark:text-zinc-500 uppercase tracking-wider mb-1 font-medium">Role</span>
          <span class="font-semibold text-zinc-800 dark:text-zinc-200">{project.role}</span>
        </div>
        <div>
          <span class="block text-zinc-400 dark:text-zinc-500 uppercase tracking-wider mb-1 font-medium">Team</span>
          <span class="font-semibold text-zinc-800 dark:text-zinc-200">{project.team}</span>
        </div>
        <div>
          <span class="block text-zinc-400 dark:text-zinc-500 uppercase tracking-wider mb-1 font-medium">Context</span>
          <span class="font-semibold text-zinc-800 dark:text-zinc-200">Internship & Real Client</span>
        </div>
        <div>
          <span class="block text-zinc-400 dark:text-zinc-500 uppercase tracking-wider mb-1 font-medium">Repository</span>
          <span class="text-zinc-500 dark:text-zinc-400 italic">Private Client Codebase</span>
        </div>
      </div>

      <!-- Tech Stack Badges -->
      <div class="mt-6 flex flex-wrap gap-1.5">
        {project.technologies.map((t) => (
          <Badge variant="default" size="sm">{t}</Badge>
        ))}
      </div>
    </header>

    <!-- Case Study Body -->
    <div class="space-y-12 text-zinc-700 dark:text-zinc-300 leading-relaxed text-sm md:text-base">
      <!-- OVERVIEW & CONTEXT -->
      <section class="reveal-on-scroll">
        <h2 class="text-xs font-sans uppercase tracking-wider text-blue-600 dark:text-blue-400 font-semibold mb-2">
          Overview & Context
        </h2>
        <h3 class="text-xl md:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 mb-4">
          Production Web Platform & Content Management System
        </h3>
        <p class="mb-4">
          Saint Ink Tattoo is a production web platform built for a commercial tattoo studio. The project was executed as part of an official software engineering internship, serving both as an academic work requirement and a real-world client delivery.
        </p>
        <p>
          The system comprises two core components: a responsive, public-facing landing page where visitors can explore the studio's portfolio and submit consultation inquiries, and an authenticated administrative Content Management System (CMS) that allows studio staff to manage website content dynamically.
        </p>
      </section>

      <!-- PROBLEM & REQUIREMENTS -->
      <section class="reveal-on-scroll">
        <h2 class="text-xs font-sans uppercase tracking-wider text-blue-600 dark:text-blue-400 font-semibold mb-2">
          The Problem
        </h2>
        <h3 class="text-xl md:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 mb-4">
          Decoupling Content Management from Database Access
        </h3>
        <p class="mb-4">
          Prior to this platform, updating studio imagery, artist bios, and promotional copy required direct engineering intervention or raw database manipulation. This posed substantial security risks, operational overhead, and a high likelihood of accidental data corruption by non-technical staff.
        </p>
        <p>
          The client required a secure, lightweight, and modern administrative interface that would give non-technical operators full control over public content while strictly safeguarding database credentials and backend integrity.
        </p>
      </section>

      <!-- WHAT I BUILT & PERSONAL CONTRIBUTION -->
      <section class="reveal-on-scroll">
        <h2 class="text-xs font-sans uppercase tracking-wider text-blue-600 dark:text-blue-400 font-semibold mb-2">
          What I Built
        </h2>
        <h3 class="text-xl md:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 mb-4">
          Backend Architecture, Data Security, & Testing
        </h3>
        <p class="mb-4">
          As the <strong>Backend Developer</strong> in a 2-person development team, my responsibilities spanned system architecture, data modeling, authentication, automated quality assurance, and deployment pipelines:
        </p>
        <ul class="space-y-2 mb-6 font-sans text-xs sm:text-sm text-zinc-800 dark:text-zinc-200">
          <li class="flex items-start gap-2">
            <span class="text-blue-500 font-bold">✓</span>
            <span><strong>Database Architecture:</strong> Designed relational schema in PostgreSQL hosted on Supabase, establishing entity relationships for gallery items, inquiries, and admin sessions.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-blue-500 font-bold">✓</span>
            <span><strong>Row Level Security (RLS):</strong> Configured granular database-level access policies restricting write and delete operations strictly to authenticated studio administrators.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-blue-500 font-bold">✓</span>
            <span><strong>Authentication & Route Guards:</strong> Integrated Supabase Auth with token validation to ensure administrative CMS routes are shielded against unauthenticated visits.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-blue-500 font-bold">✓</span>
            <span><strong>Automated Testing:</strong> Authored automated end-to-end test suites using Playwright to validate critical user and administrator workflows.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-blue-500 font-bold">✓</span>
            <span><strong>CI/CD & Deployment:</strong> Configured GitHub Actions to execute Playwright tests on every push and coordinated production deployment to Vercel.</span>
          </li>
        </ul>
      </section>

      <!-- ARCHITECTURE -->
      <section class="reveal-on-scroll">
        <h2 class="text-xs font-sans uppercase tracking-wider text-blue-600 dark:text-blue-400 font-semibold mb-2">
          System Architecture
        </h2>
        <h3 class="text-xl md:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 mb-4">
          Verified Component & Data Flow
        </h3>
        <p class="mb-6">
          The platform follows a serverless architecture designed for rapid page delivery and low maintenance overhead:
        </p>

        <ArchitectureDiagram />

        <div class="mt-4 p-4 rounded-lg bg-zinc-100/70 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 text-xs font-sans text-zinc-600 dark:text-zinc-400">
          <strong>Design Principle:</strong> Only verified components actually running in production are shown. No fictional microservices or speculative caching layers.
        </div>
      </section>

      <!-- SECURITY & DATABASE ACCESS CONTROL -->
      <section class="reveal-on-scroll">
        <h2 class="text-xs font-sans uppercase tracking-wider text-blue-600 dark:text-blue-400 font-semibold mb-2">
          Security Implementation
        </h2>
        <h3 class="text-xl md:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 mb-4">
          Defense in Depth via PostgreSQL Row Level Security
        </h3>
        <p class="mb-4">
          Because the client-side single-page application interacts with Supabase APIs, protecting database integrity could not rely solely on front-end conditional logic. A malicious actor could extract the public Supabase anon key and attempt arbitrary API calls.
        </p>
        <div class="p-4 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 mb-4 font-mono text-xs">
          <span class="text-zinc-400 block mb-2">// Verified PostgreSQL RLS Policy Pattern</span>
          <code class="text-blue-600 dark:text-blue-400">
            CREATE POLICY "Allow authenticated admin writes"<br />
            ON public.gallery_content<br />
            FOR ALL<br />
            TO authenticated<br />
            USING (auth.uid() IS NOT NULL);
          </code>
        </div>
        <p>
          By enforcing Row Level Security directly within the PostgreSQL engine, unauthenticated queries attempting write, update, or delete commands are rejected by the database regardless of client request origin.
        </p>
      </section>

      <!-- TESTING & QA -->
      <section class="reveal-on-scroll">
        <h2 class="text-xs font-sans uppercase tracking-wider text-blue-600 dark:text-blue-400 font-semibold mb-2">
          Automated Testing & CI
        </h2>
        <h3 class="text-xl md:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 mb-4">
          Playwright E2E Automation in GitHub Actions
        </h3>
        <p class="mb-4">
          To maintain release quality across both developer workstations and deployment environments, automated end-to-end (E2E) tests were implemented using <strong>Playwright</strong>.
        </p>
        <p>
          The automated test suites exercise core interactions:
        </p>
        <ul class="list-disc pl-5 space-y-1 mb-4 text-xs sm:text-sm">
          <li>Public consultation inquiry form submission and validation feedback.</li>
          <li>Authentication gates preventing unauthenticated redirection into the CMS dashboard.</li>
          <li>Responsive navigation rendering and image gallery loading across standard mobile and desktop viewports.</li>
        </ul>
        <p class="text-xs font-sans text-zinc-500 dark:text-zinc-400">
          <em>Note: In accordance with our professional honesty standards, exact percentage code coverage figures are not reported because formal instrumented coverage metrics were not preserved.</em>
        </p>
      </section>

      <!-- ENGINEERING CHALLENGE -->
      <section class="reveal-on-scroll border-l-2 border-amber-500 pl-4 sm:pl-6 py-2">
        <h2 class="text-xs font-sans uppercase tracking-wider text-amber-600 dark:text-amber-400 font-semibold mb-2">
          Engineering Challenge
        </h2>
        <h3 class="text-xl md:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 mb-4">
          Admin Authentication Latency & UI Lockup
        </h3>
        <p class="mb-4">
          During user testing of the administrative login flow, a critical usability issue surfaced: after entering valid credentials and submitting the form, the system experienced a perceptible delay of several seconds before the CMS dashboard rendered.
        </p>
        <p class="mb-4">
          Because the UI did not provide immediate visual feedback or button disabling, administrators assumed the form click had failed and repeatedly pressed the login button, firing duplicate authentication requests.
        </p>
        <div class="p-4 rounded-lg bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800 text-xs font-sans text-amber-800 dark:text-amber-300">
          <span class="font-bold block mb-1">Technical Implementation Note:</span>
          [TECHNICAL ROOT CAUSE AND SOLUTION TO BE DOCUMENTED]
          <p class="mt-1 text-xs opacity-80">
            The issue was identified and resolved during development. The exact technical root cause and code solution will be updated here once verified from the project records.
          </p>
        </div>
      </section>

      <!-- RESULT & LIMITATIONS -->
      <section class="reveal-on-scroll">
        <h2 class="text-xs font-sans uppercase tracking-wider text-blue-600 dark:text-blue-400 font-semibold mb-2">
          Results & Project Limitations
        </h2>
        <h3 class="text-xl md:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 mb-4">
          Successful Production Delivery & Honest Reflection
        </h3>
        <p class="mb-4">
          The complete platform was deployed to production, successfully fulfilling client specifications: the public landing page is live, administrative staff manage content via the custom CMS, automated tests run on GitHub Actions, and data is protected via PostgreSQL RLS.
        </p>

        <div class="p-5 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/40">
          <h4 class="text-xs font-sans uppercase tracking-wider text-zinc-700 dark:text-zinc-300 font-semibold mb-2">
            Documented Project Limitation
          </h4>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Real-world end-user testing was limited because there were not enough volunteer participants available for broader cross-demographic user testing. While unit and automated E2E tests verified core functional requirements, larger-scale usability testing under high concurrent load remains an area for future iteration.
          </p>
        </div>
      </section>

      <!-- LINKS & ASSETS -->
      <section class="reveal-on-scroll border-t border-zinc-200 dark:border-zinc-800 pt-8">
        <h2 class="text-xs font-sans uppercase tracking-wider text-blue-600 dark:text-blue-400 font-semibold mb-2">
          Deployment & Access
        </h2>
        <h3 class="text-xl md:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 mb-4">
          Live Platform Information
        </h3>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-sans">
          <div class="p-4 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
            <span class="text-zinc-400 block mb-1 font-medium">Live Hosting Status</span>
            <p class="text-zinc-800 dark:text-zinc-200 font-medium">
              Deployed on Vercel (Free tier, without custom domain)
            </p>
          </div>
          <div class="p-4 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
            <span class="text-zinc-400 block mb-1 font-medium">Source Code Policy</span>
            <p class="text-zinc-800 dark:text-zinc-200 font-medium">
              Private client repository (Not publicly disclosed)
            </p>
          </div>
        </div>

        <!-- UI Screenshots Placeholder Notice -->
        <div class="mt-6 p-6 rounded-xl border border-dashed border-zinc-300 dark:border-zinc-700 text-center font-sans text-xs text-zinc-500 dark:text-zinc-400">
          <span class="block font-semibold mb-1">[VISUAL ASSET PLACEHOLDER]</span>
          Platform screenshots (Landing page, CMS interface, and Auth workflow) will be uploaded once client privacy clearances are completed.
        </div>
      </section>
    </div>

    <!-- Case Study Footer Navigation -->
    <div class="mt-16 pt-8 border-t border-zinc-200 dark:border-zinc-800 flex items-center justify-between">
      <a
        href="/projects"
        class="text-xs font-sans font-medium text-zinc-500 hover:text-blue-600 dark:hover:text-blue-400"
      >
        ← All Projects
      </a>
      <a
        href="/projects/cinema-ticketing"
        class="text-xs font-sans font-medium text-blue-600 dark:text-blue-400 hover:underline"
      >
        Next Project: Cinema Ticketing →
      </a>
    </div>
  </div>
</Layout>

