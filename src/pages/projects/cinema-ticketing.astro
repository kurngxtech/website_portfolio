---
import Layout from '../../layouts/Layout.astro';
import Badge from '../../components/ui/Badge.astro';
import RoleMatrix from '../../components/projects/RoleMatrix.astro';
import { projects } from '../../data/projects';

const project = projects.find((p) => p.slug === 'cinema-ticketing')!;
---

<Layout
  title={`${project.title} — Case Study | Bagus Kurniawan`}
  description={project.description}
>
  <div class="py-4 md:py-8 max-w-4xl mx-auto">
    <!-- Back Navigation -->
    <div class="mb-8">
      <a
        href="/projects"
        class="inline-flex items-center text-xs font-mono text-zinc-500 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
      >
        <span class="mr-1">←</span> Back to Projects
      </a>
    </div>

    <!-- Case Study Header -->
    <header class="border-b border-zinc-200 dark:border-zinc-800 pb-8 mb-10">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <Badge variant="accent">{project.category}</Badge>
        <Badge variant="outline">{project.status}</Badge>
        <span class="text-xs font-mono text-zinc-400 dark:text-zinc-500">
          {project.year}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 mb-4">
        {project.title}
      </h1>

      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed max-w-3xl">
        {project.description}
      </p>

      <!-- Project Metadata Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-8 pt-6 border-t border-zinc-100 dark:border-zinc-800/80 text-xs font-mono">
        <div>
          <span class="block text-zinc-400 dark:text-zinc-500 uppercase tracking-wider mb-1">Role</span>
          <span class="font-semibold text-zinc-800 dark:text-zinc-200">{project.role}</span>
        </div>
        <div>
          <span class="block text-zinc-400 dark:text-zinc-500 uppercase tracking-wider mb-1">Tech Stack</span>
          <span class="font-semibold text-zinc-800 dark:text-zinc-200">Angular · MongoDB</span>
        </div>
        <div>
          <span class="block text-zinc-400 dark:text-zinc-500 uppercase tracking-wider mb-1">Architecture</span>
          <span class="font-semibold text-zinc-800 dark:text-zinc-200">Multi-Role SPA</span>
        </div>
        <div>
          <span class="block text-zinc-400 dark:text-zinc-500 uppercase tracking-wider mb-1">Repository</span>
          <a
            href="https://github.com/kurngxtech/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-blue-600 dark:text-blue-400 hover:underline"
          >
            GitHub Profile ↗
          </a>
        </div>
      </div>

      <!-- Tech Stack Badges -->
      <div class="mt-6 flex flex-wrap gap-1.5">
        {project.technologies.map((t) => (
          <Badge variant="default" size="sm">{t}</Badge>
        ))}
      </div>
    </header>

    <!-- Case Study Body -->
    <div class="space-y-12 text-zinc-700 dark:text-zinc-300 leading-relaxed text-sm md:text-base">
      <!-- Problem & Solution -->
      <section>
        <h2 class="text-xs font-mono uppercase tracking-wider text-blue-600 dark:text-blue-400 font-semibold mb-2">
          01 / Overview & Problem
        </h2>
        <h3 class="text-xl md:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 mb-4">
          Designing Multi-Tenant Cinema Operations
        </h3>
        <p class="mb-4">
          A cinema booking platform is inherently multi-faceted. Different user groups require radically different interfaces, access privileges, and data models: moviegoers need fast browsing and seat selection; cinema organizers need schedule and hall management; platform administrators need system oversight.
        </p>
        <p>
          This project focused on engineering clean separation of concerns and access control using Angular and MongoDB to support these three distinct actor journeys.
        </p>
      </section>

      <!-- Multi-Role Visualization -->
      <section>
        <h2 class="text-xs font-mono uppercase tracking-wider text-blue-600 dark:text-blue-400 font-semibold mb-2">
          02 / Role Architecture
        </h2>
        <h3 class="text-xl md:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 mb-4">
          Role-Based Interaction Model
        </h3>
        <p class="mb-6">
          The system segregates data and UI surfaces based on verified role credentials:
        </p>

        <RoleMatrix roles={project.rolesBreakdown} />
      </section>

      <!-- Contribution & Features -->
      <section>
        <h2 class="text-xs font-mono uppercase tracking-wider text-blue-600 dark:text-blue-400 font-semibold mb-2">
          03 / Engineering & Personal Contribution
        </h2>
        <h3 class="text-xl md:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 mb-4">
          Component Architecture & Data Modeling
        </h3>
        <p class="mb-4">
          Key focus areas during implementation:
        </p>
        <ul class="space-y-2 mb-4 font-mono text-xs sm:text-sm">
          <li class="flex items-start gap-2">
            <span class="text-blue-500 font-bold">↳</span>
            <span>Modular Angular frontend structured with route guards restricting access to Organizer and Admin views.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-blue-500 font-bold">↳</span>
            <span>Document schema modeling in MongoDB representing film metadata, screening halls, and booking transactions.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-blue-500 font-bold">↳</span>
            <span>[EXACT CONTRIBUTION DETAILS TO BE UPDATED FROM PROJECT REPORT]</span>
          </li>
        </ul>

        <div class="p-4 rounded-lg bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-xs font-mono text-zinc-600 dark:text-zinc-400">
          <span class="font-bold block mb-1">Content Notice:</span>
          Features and role capabilities are represented strictly according to current course documentation. Exact operational metrics and detailed feature sets will be populated upon final report audit.
        </div>
      </section>

      <!-- Technical Challenge -->
      <section>
        <h2 class="text-xs font-mono uppercase tracking-wider text-blue-600 dark:text-blue-400 font-semibold mb-2">
          04 / Technical Challenge
        </h2>
        <h3 class="text-xl md:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 mb-4">
          State Synchronization & Seat Reservation Concurrency
        </h3>
        <p class="mb-4">
          A fundamental challenge in ticketing systems is preventing race conditions where multiple customers attempt to reserve the exact same seat for a screening concurrently.
        </p>
        <div class="p-4 rounded-lg bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 font-mono text-xs text-zinc-600 dark:text-zinc-400">
          [TECHNICAL CHALLENGE & RESOLUTION DETAILS TO BE DOCUMENTED FROM REPORT]
        </div>
      </section>

      <!-- Result -->
      <section>
        <h2 class="text-xs font-mono uppercase tracking-wider text-blue-600 dark:text-blue-400 font-semibold mb-2">
          05 / Result & Reflection
        </h2>
        <h3 class="text-xl md:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 mb-4">
          Academic Project Delivery
        </h3>
        <p>
          The system demonstrated successful implementation of role-based authorization, reactive Angular state handling, and MongoDB document relationships, reinforcing system design patterns for complex multi-user applications.
        </p>
      </section>
    </div>

    <!-- Case Study Footer Navigation -->
    <div class="mt-16 pt-8 border-t border-zinc-200 dark:border-zinc-800 flex items-center justify-between">
      <a
        href="/projects/saint-ink-tattoo"
        class="text-xs font-mono text-zinc-500 hover:text-blue-600 dark:hover:text-blue-400"
      >
        ← Previous: Saint Ink Tattoo
      </a>
      <a
        href="/projects/smartwaste"
        class="text-xs font-mono text-blue-600 dark:text-blue-400 hover:underline"
      >
        Next: SmartWaste →
      </a>
    </div>
  </div>
</Layout>

