---
import Layout from '../../layouts/Layout.astro';
import Badge from '../../components/ui/Badge.astro';
import { projects } from '../../data/projects';

const project = projects.find((p) => p.slug === 'android-health')!;
---

<Layout
  title={`${project.title} — Mobile App | Bagus Kurniawan`}
  description={project.description}
>
  <div class="py-4 md:py-8 max-w-3xl mx-auto">
    <!-- Back Navigation -->
    <div class="mb-8">
      <a
        href="/projects"
        class="inline-flex items-center text-xs font-sans font-medium text-zinc-500 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
      >
        <span class="mr-1">←</span> Back to Projects
      </a>
    </div>

    <!-- Case Study Header -->
    <header class="border-b border-zinc-200 dark:border-zinc-800 pb-8 mb-10">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <Badge variant="default">{project.category}</Badge>
        <span class="text-xs font-sans font-medium text-zinc-400 dark:text-zinc-500">
          {project.year}
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 mb-4">
        {project.title}
      </h1>

      <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed">
        {project.description}
      </p>

      <!-- Metadata Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mt-6 pt-6 border-t border-zinc-100 dark:border-zinc-800/80 text-xs font-sans">
        <div>
          <span class="block text-zinc-400 dark:text-zinc-500 uppercase tracking-wider mb-1 font-semibold">Language</span>
          <span class="font-medium text-zinc-800 dark:text-zinc-200">Kotlin</span>
        </div>
        <div>
          <span class="block text-zinc-400 dark:text-zinc-500 uppercase tracking-wider mb-1 font-semibold">Platform</span>
          <span class="font-medium text-zinc-800 dark:text-zinc-200">Android SDK</span>
        </div>
        <div>
          <span class="block text-zinc-400 dark:text-zinc-500 uppercase tracking-wider mb-1 font-semibold">Role</span>
          <span class="font-medium text-zinc-800 dark:text-zinc-200">{project.role}</span>
        </div>
      </div>
    </header>

    <!-- Case Study Body -->
    <div class="space-y-10 text-zinc-700 dark:text-zinc-300 leading-relaxed text-sm">
      <section>
        <h2 class="text-xs font-sans uppercase tracking-wider text-blue-600 dark:text-blue-400 font-semibold mb-2">
          Overview & Purpose
        </h2>
        <p class="mb-3">
          A mobile application developed to explore native Android development paradigms using Kotlin, focusing on clean UI layout, device lifecycle handling, and local storage.
        </p>
        <p class="text-xs font-sans text-zinc-500 dark:text-zinc-400">
          <em>Transparency Note: No clinical or medical claims are made. The app is strictly an academic tracking and logging tool.</em>
        </p>
      </section>

      <section>
        <h2 class="text-xs font-sans uppercase tracking-wider text-blue-600 dark:text-blue-400 font-semibold mb-2">
          Technical Implementation
        </h2>
        <ul class="space-y-2 text-sm text-zinc-600 dark:text-zinc-400">
          <li class="flex items-start gap-2">
            <span class="text-blue-500 font-bold">•</span>
            <span>Native Kotlin architecture integrating Android Jetpack components.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-blue-500 font-bold">•</span>
            <span>Local persistence for daily habit and activity records.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-blue-500 font-bold">•</span>
            <span>[DETAILED IMPLEMENTATION TO BE POPULATED FROM PROJECT REPORT]</span>
          </li>
        </ul>
      </section>

      <section class="border-t border-zinc-200 dark:border-zinc-800 pt-6">
        <h2 class="text-xs font-sans uppercase tracking-wider text-blue-600 dark:text-blue-400 font-semibold mb-2">
          Repository & Screenshots
        </h2>
        <div class="p-4 rounded-lg border border-dashed border-zinc-300 dark:border-zinc-700 text-center font-sans text-xs text-zinc-500 dark:text-zinc-400">
          [SCREENSHOTS & REPOSITORY LINK PLACEHOLDER — Verified upon report audit]
        </div>
      </section>
    </div>

    <!-- Case Study Footer Navigation -->
    <div class="mt-12 pt-6 border-t border-zinc-200 dark:border-zinc-800 flex items-center justify-between">
      <a
        href="/projects/smartwaste"
        class="text-xs font-sans font-medium text-zinc-500 hover:text-blue-600 dark:hover:text-blue-400"
      >
        ← Previous: SmartWaste
      </a>
      <a
        href="/projects/seed-of-hope"
        class="text-xs font-sans font-medium text-blue-600 dark:text-blue-400 hover:underline"
      >
        Next: Seed of Hope →
      </a>
    </div>
  </div>
</Layout>

