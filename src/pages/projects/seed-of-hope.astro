---
import Layout from '../../layouts/Layout.astro';
import Badge from '../../components/ui/Badge.astro';
import { projects } from '../../data/projects';

const project = projects.find((p) => p.slug === 'seed-of-hope')!;
---

<Layout
  title={`${project.title} — Web Project | Bagus Kurniawan`}
  description={project.description}
>
  <div class="py-4 md:py-8 max-w-3xl mx-auto">
    <!-- Back Navigation -->
    <div class="mb-8">
      <a
        href="/projects"
        class="inline-flex items-center text-xs font-sans font-medium text-zinc-500 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
      >
        <span class="mr-1">←</span> Back to Projects
      </a>
    </div>

    <!-- Case Study Header -->
    <header class="border-b border-zinc-200 dark:border-zinc-800 pb-8 mb-10">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <Badge variant="default">{project.category}</Badge>
        <span class="text-xs font-sans font-medium text-zinc-400 dark:text-zinc-500">
          {project.year}
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 mb-4">
        {project.title}
      </h1>

      <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed">
        {project.description}
      </p>

      <!-- Metadata Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mt-6 pt-6 border-t border-zinc-100 dark:border-zinc-800/80 text-xs font-sans">
        <div>
          <span class="block text-zinc-400 dark:text-zinc-500 uppercase tracking-wider mb-1 font-semibold">Stack</span>
          <span class="font-medium text-zinc-800 dark:text-zinc-200">HTML · CSS · JS</span>
        </div>
        <div>
          <span class="block text-zinc-400 dark:text-zinc-500 uppercase tracking-wider mb-1 font-semibold">Purpose</span>
          <span class="font-medium text-zinc-800 dark:text-zinc-200">Community Support</span>
        </div>
        <div>
          <span class="block text-zinc-400 dark:text-zinc-500 uppercase tracking-wider mb-1 font-semibold">Role</span>
          <span class="font-medium text-zinc-800 dark:text-zinc-200">{project.role}</span>
        </div>
      </div>
    </header>

    <!-- Case Study Body -->
    <div class="space-y-10 text-zinc-700 dark:text-zinc-300 leading-relaxed text-sm">
      <section>
        <h2 class="text-xs font-sans uppercase tracking-wider text-blue-600 dark:text-blue-400 font-semibold mb-2">
          Purpose & Background
        </h2>
        <p class="mb-3">
          Developed as a clean, responsive static website to give an orphanage community an accessible digital presence for public awareness, volunteer inquiries, and donor communication.
        </p>
      </section>

      <section>
        <h2 class="text-xs font-sans uppercase tracking-wider text-blue-600 dark:text-blue-400 font-semibold mb-2">
          Website Structure & Frontend Implementation
        </h2>
        <ul class="space-y-2 text-sm text-zinc-600 dark:text-zinc-400">
          <li class="flex items-start gap-2">
            <span class="text-blue-500 font-bold">•</span>
            <span>Semantic HTML5 document hierarchy ensuring accessibility and screen-reader support.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-blue-500 font-bold">•</span>
            <span>Mobile-first CSS with flexible grid and media queries ensuring reliable rendering from 320px screens.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-blue-500 font-bold">•</span>
            <span>Zero build complexity and immediate performance through vanilla web fundamentals.</span>
          </li>
        </ul>
      </section>

      <section class="border-t border-zinc-200 dark:border-zinc-800 pt-6">
        <h2 class="text-xs font-sans uppercase tracking-wider text-blue-600 dark:text-blue-400 font-semibold mb-2">
          Organization Context
        </h2>
        <div class="p-4 rounded-lg bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-xs font-sans text-zinc-600 dark:text-zinc-400">
          [REAL ORGANIZATION CONTEXT TO BE CONFIRMED UPON FINAL ASSET REVIEW]
        </div>
      </section>
    </div>

    <!-- Case Study Footer Navigation -->
    <div class="mt-12 pt-6 border-t border-zinc-200 dark:border-zinc-800 flex items-center justify-between">
      <a
        href="/projects/android-health"
        class="text-xs font-sans font-medium text-zinc-500 hover:text-blue-600 dark:hover:text-blue-400"
      >
        ← Previous: Android Health
      </a>
      <a
        href="/projects"
        class="text-xs font-sans font-medium text-blue-600 dark:text-blue-400 hover:underline"
      >
        All Projects →
      </a>
    </div>
  </div>
</Layout>

