---
import Layout from '../../layouts/Layout.astro';
import Badge from '../../components/ui/Badge.astro';
import { notes, type Note } from '../../data/notes';

export function getStaticPaths() {
  return notes.map((note) => ({
    params: { slug: note.slug },
    props: { note },
  }));
}

export interface Props {
  note: Note;
}

const { note } = Astro.props;
---

<Layout
  title={`${note.title} | Bagus Kurniawan`}
  description={note.summary}
  article={true}
>
  <article class="py-4 md:py-8 max-w-3xl mx-auto">
    <!-- Back to Notes Navigation -->
    <div class="mb-8">
      <a
        href="/notes"
        class="inline-flex items-center text-xs font-mono text-zinc-500 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
      >
        <span class="mr-1">←</span> Back to Notes
      </a>
    </div>

    <!-- Article Header -->
    <header class="border-b border-zinc-200 dark:border-zinc-800 pb-8 mb-10">
      <div class="flex flex-wrap items-center gap-2 mb-3 text-xs font-mono">
        <Badge variant="accent">{note.category}</Badge>
        <span class="text-zinc-400 dark:text-zinc-500">
          {note.date} · {note.readingTime}
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 mb-4">
        {note.title}
      </h1>

      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed italic border-l-2 border-blue-600 pl-4 py-1">
        {note.summary}
      </p>

      <div class="mt-6 flex flex-wrap gap-1.5">
        {note.technologies.map((t) => (
          <Badge variant="default" size="sm">
            {t}
          </Badge>
        ))}
      </div>
    </header>

    <!-- Article Content -->
    <div class="prose prose-zinc dark:prose-invert max-w-none space-y-6 text-zinc-700 dark:text-zinc-300 leading-relaxed text-sm sm:text-base">
      {
        note.content.map((paragraph) => {
          if (paragraph.startsWith('1.') || paragraph.startsWith('2.') || paragraph.startsWith('3.') || paragraph.startsWith('-')) {
            return (
              <p class="pl-4 border-l border-zinc-200 dark:border-zinc-800 font-mono text-xs sm:text-sm text-zinc-800 dark:text-zinc-200">
                {paragraph}
              </p>
            );
          }
          if (paragraph.includes('[TECHNICAL ROOT CAUSE')) {
            return (
              <div class="p-4 rounded-lg bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800 text-xs font-mono text-amber-800 dark:text-amber-300">
                {paragraph}
              </div>
            );
          }
          return <p>{paragraph}</p>;
        })
      }
    </div>

    <!-- Article Footer -->
    <footer class="mt-16 pt-8 border-t border-zinc-200 dark:border-zinc-800 flex items-center justify-between">
      <a
        href="/notes"
        class="text-xs font-mono text-zinc-500 hover:text-blue-600 dark:hover:text-blue-400"
      >
        ← All Engineering Notes
      </a>
      <a
        href="/contact"
        class="text-xs font-mono text-blue-600 dark:text-blue-400 hover:underline"
      >
        Discuss this note with Bagus →
      </a>
    </footer>
  </article>
</Layout>

